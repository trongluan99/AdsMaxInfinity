<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_banner"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:text="AppLovin MAX Demo"
                android:textColor="#333333"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_show_inter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Show Interstitial Ad" />

            <Button
                android:id="@+id/btn_show_reward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Show Rewarded Ad" />

            <Button
                android:id="@+id/btn_mediation_debugger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Open Mediation Debugger" />

            <Button
                android:id="@+id/btn_test_iap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Test In-App Purchase (IAP)" />

            <Button
                android:id="@+id/btn_cmp_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Privacy / CMP Settings (GDPR)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Native Ad:"
                android:textColor="#555555"
                android:textStyle="bold" />

            <include layout="@layout/layout_native_medium" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/layout_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <include layout="@layout/layout_banner_control" />
    </FrameLayout>

</RelativeLayout>
